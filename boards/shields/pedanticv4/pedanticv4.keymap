#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        base_encoder_scroll: base_encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc MOVE_Y(64)>, <&msc MOVE_Y(-64)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer { // Base Layer
            display-name = "Base";
            bindings = <
            &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp ESC       &kp K_PWR &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS 
            &kp TAB &kp Q &kp W &kp E &kp R &kp T &mo 3                &mo 3 &kp Y &kp U &kp I &kp O &kp P &kp BSLH 
            &kp CAPS &kp A &kp S &kp D &kp F &kp G &mo 2               &mo 2 &kp H &kp J &kp K &kp L &kp SEMI &kp SQT 
            &kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &mkp LCLK        &mkp RCLK &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
            &none &kp PLUS                                                   &kp LBKT &kp RBKT 
                                        &kp BSPC &kp SPACE &mo 1       &mo 1 &kp SPACE &kp ENTER  
                                        &kp LGUI &kp LCTRL &kp LALT    &kp RALT &kp RCTRL &kp DEL  
            >;
            sensor-bindings = <
            &inc_dec_kp LEFT RIGHT 
            &base_encoder_scroll
            >;
        };
        fnnav { // Layer 1
            display-name = "Func/Nav";
            bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &none            &none &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 
            &none &none &none &kp PG_UP &kp HOME &none &mo 3           &mo 3 &none &none &none &none &none &none 
            &none &none &none &kp PG_DN &kp END &none &mo 2            &mo 2 &none &kp LEFT &kp UP &kp RIGHT &none &none 
            &none &none &none &none &none &none &kp C_PP               &none &none &none &kp DOWN &none &none &none 
            &kp LC(LG(LEFT)) &kp LC(LG(RIGHT))                                &none &none 
                                        &kp BSPC &kp SPACE &mo 1       &mo 1 &kp SPACE &kp ENTER  
                                        &kp LGUI &kp LCTRL &kp LALT    &kp RALT &kp RCTRL &kp DEL  
            >;
            sensor-bindings = <
            &inc_dec_kp LEFT RIGHT 
            &inc_dec_kp C_VOL_UP C_VOL_DN 
            >;
        };
        math { // Layer 2
            display-name = "Math";
            bindings = <
            &studio_unlock &none &none &none &none &none &bootloader     &bootloader &none &none &none &none &kp KP_DIVIDE &none
            &none &none &none &none &none &none &mo 3                    &mo 3 &none &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MULTIPLY &none
            &none &none &none &none &none &none &mo 2                    &mo 2 &none &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_MINUS &none
            &none &none &none &none &none &none &kp C_PP                 &none &none &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_PLUS &none
            &none &none                                                         &kp KP_N0 &none
                                        &kp BSPC &kp SPACE &mo 1       &mo 1 &kp SPACE &kp ENTER
                                        &kp LGUI &kp LCTRL &kp LALT    &kp RALT &kp RCTRL &kp DEL
            >;
            sensor-bindings = <
            &inc_dec_kp LEFT RIGHT 
            &inc_dec_kp C_VOL_UP C_VOL_DN 
            >;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };
    };
};


